NAME="YouTube"
# The /tv endpoint is the real 10-foot interface, the same one smart TVs load,
# and it is also the endpoint the DIAL receiver hands a pairing code to.
URL="https://www.youtube.com/tv"
ICON="freetvos-youtube"
CATEGORY="AudioVideo;Video;Player;"
DRM="no"
# Without a TV user agent this endpoint bounces straight to the desktop site.
USER_AGENT="Mozilla/5.0 (SMART-TV; Linux; Tizen 6.0) AppleWebKit/537.36 (KHTML, like Gecko) 76.0.3809.146 TV Safari/537.36"
SPATIAL_NAV="no"
