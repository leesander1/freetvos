#!/usr/bin/env bash
# freetvos-webapp <app-id>
#
# One launcher for every streaming service. Each service is a declarative file
# in /usr/share/freetvos/webapps, so adding one is a text file and no new code.
#
# Chromium rather than the upstream Bigscreen webapp viewer, for a hard reason:
# the viewer is QtWebEngine, and the aarch64 QtWebEngine only knows the
# _platform_specific/linux_x64 CDM path. It cannot load an ARM Widevine module
# at all. Chromium knows linux_arm64. On ARM, Chromium is the only host that
# can play a DRM service.
set -euo pipefail

APP_ID="${1:-}"
# An optional deep link, used by pinned tiles. It rides on the service's own
# definition, so a pin inherits that service's profile, user agent and CDM
# wiring instead of becoming a second, half-configured copy of it.
URL_OVERRIDE="${2:-}"
# Two places, the viewer's own first. The services that ship with the product
# live in the image; anything added on the device with freetvos-service lives in
# their config directory, because /usr is a read-only image under bootc.
# Searching the local one first also means a definition there can override a
# shipped service, which is the only way to follow a provider that moves its
# address without rebuilding the operating system.
SYSTEM_APP_DIR="/usr/share/freetvos/webapps"
USER_APP_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/freetvos/webapps"
[ -n "$APP_ID" ] || { echo "usage: freetvos-webapp <app-id> [url]" >&2; exit 2; }
APP_FILE=""
for dir in "$USER_APP_DIR" "$SYSTEM_APP_DIR"; do
  if [ -r "$dir/$APP_ID.app" ]; then APP_FILE="$dir/$APP_ID.app"; break; fi
done
[ -n "$APP_FILE" ] || { echo "no such app: $APP_ID" >&2; exit 3; }

NAME=""; URL=""; DRM="no"; USER_AGENT=""; SPATIAL_NAV="no"; EXTENSIONS="yes"
# shellcheck disable=SC1090
. "$APP_FILE"
[ -n "$URL_OVERRIDE" ] && URL="$URL_OVERRIDE"
[ -n "$URL" ] || { echo "$APP_ID: no URL defined" >&2; exit 4; }

# Per-app profile. Isolating them keeps one service's cookies, and one
# service's corrupted cache, away from every other service.
PROFILE="${XDG_DATA_HOME:-$HOME/.local/share}/freetvos/webapps/$APP_ID"
mkdir -p "$PROFILE"

# Panel geometry. Streaming services choose quality from the size of the
# player, so a viewport smaller than the panel silently costs resolution.
read -r PANEL_W PANEL_H < <(
  kscreen-doctor -o 2>/dev/null \
    | grep -oE '[0-9]{3,5}x[0-9]{3,5}' \
    | head -1 | tr 'x' ' '
)
PANEL_W="${PANEL_W:-1920}"
PANEL_H="${PANEL_H:-1080}"

FLAGS=(
  "--app=$URL"
  "--user-data-dir=$PROFILE"
  "--class=freetvos-$APP_ID"

  # Without this Chromium picks up a Wayland output scale and halves the CSS
  # viewport: a 1920x1080 panel reported itself as 945x1060, which is enough on
  # its own to keep YouTube below 1080p. Pinning the scale to 1 makes one CSS
  # pixel one panel pixel.
  "--force-device-scale-factor=1"
  "--window-size=$PANEL_W,$PANEL_H"

  # A television has no pointer, so a scrollbar is decoration that cannot be
  # used. YouTube TV drew one down the right edge.
  "--hide-scrollbars"

  # Pin the colour scheme reported to pages. Chromium here tells every page it
  # prefers light even while the desktop portal reports dark, so sites that
  # follow prefers-color-scheme paint a white background on a television. This
  # forces the dark branch. Blink's enum is kDark=0, kLight=1.
  "--blink-settings=preferredColorScheme=0"

  # Wayland natively; going through XWayland costs a copy per frame and
  # breaks fractional scaling on 4K panels.
  "--ozone-platform=wayland"

  "--start-fullscreen"
  "--autoplay-policy=no-user-gesture-required"

  # Let the compositor offer its on-screen keyboard to a focused text field.
  # Signing into a service is the one thing on this television that needs
  # typing, and there is no keyboard attached to it. Configured and not
  # confirmed: the keyboard process runs, but it was never seen to appear over
  # a Chromium field in the VM.
  "--enable-wayland-ime"

  # One --enable-features only: Chromium honours the last occurrence and
  # silently discards every earlier one, so a second flag would quietly turn
  # off Wayland and hardware decode.
  # DocumentPictureInPictureAPI adds the newer PiP that can host arbitrary
  # content, alongside the video-element PiP that is on by default.
  "--enable-features=UseOzonePlatform,WaylandWindowDecorations,VaapiVideoDecoder,AcceleratedVideoDecodeLinuxGL,DocumentPictureInPictureAPI"

  # No Cast sender: this device is a receiver, and the menu entry only
  # confuses a remote-driven interface.
  "--disable-features=Translate,MediaRouter,GlobalMediaControls"

  # Do not ask KDE's wallet for a key to encrypt cookies with. On a desktop
  # that prompt is a minor annoyance; here it is a dead end, because the device
  # auto-logs in and has no keyboard, so nobody can answer it and the service
  # never finishes loading.
  #
  # The trade is real and worth stating: cookies and saved passwords are then
  # protected by file permissions rather than by a wallet key. On a
  # single-account appliance whose disk is not encrypted anyway, anyone who can
  # read those files can already read the wallet database too.
  "--password-store=basic"

  "--no-first-run"
  "--no-default-browser-check"
  "--disable-session-crashed-bubble"
  "--hide-crash-restore-bubble"
  "--check-for-update-interval=31536000"
)

# Extensions. Every directory holding a manifest.json under the extensions
# folder is loaded unpacked. Chromium 152 in Fedora still honours
# --load-extension; Google disabled that switch upstream in 137, so this is
# worth re-testing after a Chromium bump rather than assumed to keep working.
#
# Set EXTENSIONS="no" in a service's .app file to launch it clean, which is
# worth doing when diagnosing a playback problem: an extension that rewrites
# requests is the first thing to rule out.
if [ "${EXTENSIONS:-yes}" = "yes" ]; then
  EXT_LIST=""
  # Two directories: ones shipped with the image, and ones the owner added.
  # The shipped set is what makes a mouse-built web page usable from a sofa,
  # so it loads for every service rather than being something to discover.
  for EXT_DIR in \
    "/usr/share/freetvos/extensions" \
    "${XDG_DATA_HOME:-$HOME/.local/share}/freetvos/extensions"
  do
    [ -d "$EXT_DIR" ] || continue
    for d in "$EXT_DIR"/*/; do
      [ -f "$d/manifest.json" ] || continue
      EXT_LIST="${EXT_LIST:+$EXT_LIST,}${d%/}"
    done
  done
  [ -n "$EXT_LIST" ] && FLAGS+=( "--load-extension=$EXT_LIST" )
fi

# Several services serve a degraded player, or refuse entirely, when they see
# Linux. The override is per-app because the ones that do not check are better
# left honest.
[ -n "$USER_AGENT" ] && FLAGS+=( "--user-agent=$USER_AGENT" )

# D-pad navigation for sites without their own arrow-key handling. Left off by
# default: the real TV interfaces handle arrows themselves and fight it.
[ "$SPATIAL_NAV" = "yes" ] && FLAGS+=( "--enable-spatial-navigation" )

if [ "$DRM" = "yes" ]; then
  # There is no --widevine-path flag; Chromium ignores unknown flags silently,
  # so passing one looks like it works and never does. The CDM is found only by
  # location: the image symlinks /opt/google/chrome/WidevineCdm, which Chromium
  # treats as a bundled module, to the directory the installer populates.
  case "$(uname -m)" in
    x86_64)         CDM_PLATFORM=linux_x64 ;;
    aarch64|arm64)  CDM_PLATFORM=linux_arm64 ;;
    *)              CDM_PLATFORM=unknown ;;
  esac
  # Through /opt, which is the path Chromium itself checks, so this asks the
  # same question Chromium will. It resolves whether the module was baked into
  # the image or fetched into /var afterwards.
  CDM_SO="/opt/google/chrome/WidevineCdm/_platform_specific/$CDM_PLATFORM/libwidevinecdm.so"

  if [ ! -e "$CDM_SO" ]; then
    # If the device is already fetching it, say that instead of asking for a
    # command. On first boot this is the usual case, and telling someone to open
    # a terminal when the thing is already downloading is just wrong.
    if systemctl is-active --quiet freetvos-widevine-install.service 2>/dev/null; then
      MSG="$NAME needs Widevine, which is downloading now. Try again in a minute."
    else
      MSG="$NAME needs Widevine, which is not installed."
    fi
    # A television has no terminal. Say it on screen, or the tile just looks
    # dead and the reason is buried in a log nobody will ever open.
    #
    # Unless something is launching several services at once and will report
    # for all of them. Two dialogs for one problem is worse than one.
    if [ -n "${FREETVOS_QUIET:-}" ]; then
      echo "$MSG Run: sudo freetvos-widevine-install" >&2
      exit 5
    fi
    if command -v kdialog >/dev/null 2>&1; then
      kdialog --title "$NAME unavailable" \
        --error "$MSG\n\nRun this once from a terminal or over ssh:\n  sudo freetvos-widevine-install" &
    elif command -v notify-send >/dev/null 2>&1; then
      notify-send -u critical "$NAME unavailable" \
        "$MSG Run: sudo freetvos-widevine-install"
    fi
    echo "$MSG Run: sudo freetvos-widevine-install" >&2
    exit 5
  fi
fi

exec /usr/bin/chromium-browser "${FLAGS[@]}"
