[Unit]
Description=FreeTVOS AirPlay receiver
Documentation=https://github.com/FDH2/UxPlay
After=network-online.target avahi-daemon.service sound.target
Wants=network-online.target
Requires=avahi-daemon.service

[Service]
Type=simple
User=tv

# -p pins the standard AirPlay ports (7000/7001/7100 TCP, 6000/6001/7011 UDP)
# instead of binding whatever is free. UxPlay works either way because clients
# find it over mDNS, but a dynamic port cannot be written into a firewall rule,
# and this device is meant to sit on a home network behind one.
#
# waylandsink, not glimagesink. The shell is Wayland, so this hands buffers
# straight to the compositor with no GL context of its own. glimagesink needs
# working EGL and fails outright on hardware without acceleration, which is
# exactly what a cheap TV box and a QEMU virtio-gpu both are. Override with
# FREETVOS_VIDEO_SINK on hardware where GL is genuinely faster.
Environment=FREETVOS_VIDEO_SINK=waylandsink
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=WAYLAND_DISPLAY=wayland-0
EnvironmentFile=-/etc/freetvos/airplay.conf

# -hls takes AirPlay's other mode, where an app hands over a video's address
# rather than mirroring the screen: without it UxPlay accepted the connection,
# played only the sound, and showed nothing. It covers the YouTube app. Apps
# that send FairPlay-protected video (Netflix, Disney+, Peacock, Apple TV)
# cannot be played by any receiver that is not Apple's or licensed by it; for
# those, the service's own tile on the television is the way.
#
# Not -scrsv, which would keep the screensaver off during video: UxPlay 1.73.7
# aborts at start with it ("basic_string: construction from null is not
# valid"), with or without a session bus.
ExecStart=/bin/sh -c 'exec /usr/bin/uxplay -n "FreeTVOS" -nh -p -hls \
  -vs "$FREETVOS_VIDEO_SINK" -as autoaudiosink'

Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical.target
