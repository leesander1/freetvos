# FreeTVOS: Breeze Dark in the FreeTVOS palette.
#
# Derived from Breeze Dark (LGPL-2.0-or-later, the KDE Breeze authors) with
# every colour swapped for the one FreeTVOS's own pages use, so Bigscreen's
# home screen, its settings and every KDE dialog match them:
#
#   background  #0B0E14   what a page sits on (Window, Header)
#   surface     #151A23   what sits on it (View, Tooltip)
#   raised      #1B212C   buttons
#   text        #E6EAF2   and #8C97AB where Breeze dims it
#   accent      #3DDC97   every highlight, focus and hover, in place of Breeze
#                         blue; the selected tile's frame comes from here
#   deep accent #18583D   alternate backgrounds that were dark blue
#   link        #4EA8FF   the second brand colour
#
# Writing on a selected row is dark, #0B0E14, because white on #3DDC97 is not
# legible. Filled highlights elsewhere (a focused row in Bigscreen's settings)
# need no entry: KDE tints the background with the accent, which comes out a
# deep green that white writing reads on.

[ColorEffects:Disabled]
Color=56,56,56
ColorAmount=0
ColorEffect=0
ContrastAmount=0.65
ContrastEffect=1
IntensityAmount=0.1
IntensityEffect=2

