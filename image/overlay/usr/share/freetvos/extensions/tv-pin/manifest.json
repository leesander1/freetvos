{
  "manifest_version": 3,
  "name": "FreeTVOS pin",
  "version": "1.0",
  "description": "Pin what is on screen to the home screen, with Menu on the remote",
  "key": "",
  "permissions": [
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "pin.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
