/*
 * Tile the FreeTVOS service windows into a grid.
 *
 * A KWin script rather than an external tool, because on Wayland only the
 * compositor may move a window. Nothing outside KWin can place these, which is
 * why the usual desktop tiling utilities do not work here.
 *
 * @LAYOUT@ is replaced before loading; KWin scripts take no arguments, and
 * generating the script with the layout inlined avoids inventing a
 * configuration channel for one integer.
 *
 * Panes are ordered by window class so that this script and the audio helper
 * that runs alongside it agree on which pane is first without having to talk
 * to each other.
 */
(function () {
    var layout = @LAYOUT@;

    function serviceWindows() {
        var all = workspace.windowList ? workspace.windowList() : workspace.clientList();
        var out = [];
        for (var i = 0; i < all.length; i++) {
            var w = all[i];
            if (!w || !w.normalWindow) continue;
            var cls = String(w.resourceClass || "");
            if (cls.indexOf("freetvos-") !== 0) continue;
            out.push(w);
        }
        out.sort(function (a, b) {
            return String(a.resourceClass) < String(b.resourceClass) ? -1 : 1;
        });
        return out;
    }

    var wins = serviceWindows();
    if (wins.length === 0) return;

    var area = workspace.clientArea(KWin.MaximizeArea, workspace.activeScreen,
                                   workspace.currentDesktop);

    // Fullscreen is a separate mode in the compositor, not just a large
    // geometry. A fullscreen window ignores any rectangle set on it, so it has
    // to be cleared before tiling or the panes silently stay stacked.
    for (var i = 0; i < wins.length; i++) {
        if (wins[i].fullScreen) wins[i].fullScreen = false;
        wins[i].setMaximize(false, false);
    }

    if (layout === 1) {
        wins[0].fullScreen = true;
        return;
    }

    var cols = layout === 2 ? 2 : 2;
    var rows = layout === 2 ? 1 : 2;
    var count = Math.min(wins.length, cols * rows);

    for (var n = 0; n < count; n++) {
        var col = n % cols;
        var row = Math.floor(n / cols);
        var w = Math.floor(area.width / cols);
        var h = Math.floor(area.height / rows);
        wins[n].frameGeometry = {
            x: area.x + col * w,
            y: area.y + row * h,
            width: w,
            height: h
        };
    }

    // Anything beyond the grid is left where it is rather than hidden, so a
    // fourth service opened by accident does not vanish without explanation.
    if (count > 0) workspace.activeWindow = wins[0];
})();
