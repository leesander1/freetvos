#!/usr/bin/env python3
"""A TV tuner plugged into this box: antenna and cable channels in Live TV.

Off unless switched on. TVHeadend does the tuning, channel scanning and
programme guide, and runs only while this option is on, listening on the box
itself and nowhere else. Its own setup is a web page built for a mouse, so the
parts a television needs are driven here through its API instead, and the
tuner's channels arrive in Live TV next to anything else there.

  freetvos-tuner status
  freetvos-tuner on | off
  freetvos-tuner standards                  antenna and cable, by part of the world
  freetvos-tuner regions atsc-t             transmitters or frequency plans for one
  freetvos-tuner scan atsc-t atsc-t/us/atsc-t_us-ATSC-center-frequencies-8VSB
"""
import argparse
import importlib.machinery
import importlib.util
import json
import os
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

API = os.environ.get("FREETVOS_TVH", "http://127.0.0.1:9981")
MARKER = Path(os.environ.get("FREETVOS_TUNER_MARKER",
                             "/var/lib/freetvos/tuner-enabled"))
DEV = Path(os.environ.get("FREETVOS_TUNER_DEV", "/dev/dvb"))
LIVETV_CMD = os.environ.get("FREETVOS_LIVETV_CMD", "/usr/bin/freetvos-livetv")
SYSTEMCTL = os.environ.get("FREETVOS_SYSTEMCTL", "systemctl")
RUNTIME = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"))
PROGRESS = Path(os.environ.get("FREETVOS_TUNER_PROGRESS",
                               RUNTIME / "freetvos/tuner-scan.json"))
UNIT = "tvheadend.service"

SCAN_TIMEOUT = 20 * 60

# What a viewer chooses from. Satellite is left out on purpose: it needs the
# dish's LNB and switch described before a scan means anything, which is not a
# question to put to someone holding a remote.
STANDARDS = [
    {"id": "atsc-t", "name": "Antenna", "where": "United States, Canada, Mexico, South Korea",
     "network": "dvb_network_atsc_t", "frontend": "linuxdvb_frontend_atsc_t"},
    {"id": "atsc-c", "name": "Cable", "where": "United States",
     "network": "dvb_network_atsc_c", "frontend": "linuxdvb_frontend_atsc_c"},
    {"id": "dvbt", "name": "Antenna", "where": "Europe, Australia, most of Asia and Africa",
     "network": "dvb_network_dvbt", "frontend": "linuxdvb_frontend_dvbt"},
    {"id": "dvbc", "name": "Cable", "where": "Europe",
     "network": "dvb_network_dvbc", "frontend": "linuxdvb_frontend_dvbc"},
    {"id": "isdb-t", "name": "Antenna", "where": "Japan, Brazil and most of South America",
     "network": "dvb_network_isdb_t", "frontend": "linuxdvb_frontend_isdb_t"},
]
BY_ID = {s["id"]: s for s in STANDARDS}

LIVETV_PLAYLIST = f"{API}/playlist/channels.m3u"
LIVETV_GUIDE = f"{API}/xmltv/channels"


class TunerError(Exception):
    pass


# ---------------------------------------------------------------------------
# TVHeadend's API.
# ---------------------------------------------------------------------------


def call(path: str, params: dict = None, timeout: float = 15):
    """One API request. Parameters are sent as a form, as TVHeadend expects."""
    data = urllib.parse.urlencode(params).encode() if params is not None else None
    request = urllib.request.Request(f"{API}/api/{path}", data=data)
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            body = response.read()
    except urllib.error.HTTPError as exc:
        raise TunerError(f"the tuner service refused {path}: {exc.code}") from exc
    except (urllib.error.URLError, OSError) as exc:
        raise TunerError("the tuner service is not running") from exc
    if not body.strip():
        return {}
    try:
        return json.loads(body)
    except ValueError as exc:
        raise TunerError(f"the tuner service sent something unreadable for {path}") from exc


def running() -> bool:
    try:
        return "sw_version" in call("serverinfo", timeout=3)
    except TunerError:
        return False


# ---------------------------------------------------------------------------
# The option itself.
# ---------------------------------------------------------------------------


def enabled() -> bool:
    return MARKER.exists()


def set_enabled(on: bool, wait: float = 40) -> None:
    """Switch the tuner service on or off, and remember the choice for boot.

    The choice is a file rather than an enabled unit because the television's
    user may start and stop the one service, which a rule allows, but may not
    change what starts at boot, which would take far broader permission.
    """
    if on:
        MARKER.parent.mkdir(parents=True, exist_ok=True)
        MARKER.write_text("switched on from Live TV\n")
    else:
        try:
            MARKER.unlink()
        except OSError:
            pass
    verb = "start" if on else "stop"
    done = subprocess.run([SYSTEMCTL, verb, UNIT], capture_output=True, text=True)
    if done.returncode != 0:
        raise TunerError(f"could not {verb} the tuner service: "
                         f"{(done.stderr or done.stdout).strip()[:160]}")
    if on:
        deadline = time.time() + wait
        while time.time() < deadline:
            if running():
                return
            time.sleep(1)
        raise TunerError("the tuner service started but is not answering")


def tuners_present() -> list:
    """Tuners the kernel sees, whether or not the service is running.

    A tuner with a driver but no firmware still gets a device node, so this
    answers "is anything plugged in", and the frontends list below answers
    "can TVHeadend use it".
    """
    try:
        return sorted(str(f.relative_to(DEV))
                      for f in DEV.glob("adapter*/frontend*"))
    except OSError:
        return []


def frontends() -> list:
    """Every tuner input TVHeadend has found, with what kind it is."""
    found = []

    def walk(uuid: str, depth: int = 0):
        if depth > 6:
            return
        nodes = call("hardware/tree", {"uuid": uuid})
        for node in nodes if isinstance(nodes, list) else []:
            cls = node.get("class", "")
            if cls.startswith("linuxdvb_frontend"):
                found.append({"uuid": node["uuid"], "class": cls,
                              "name": node.get("text", "")})
            if not node.get("leaf"):
                walk(node["uuid"], depth + 1)

    walk("root")
    return found


# ---------------------------------------------------------------------------
# Scanning.
# ---------------------------------------------------------------------------


def regions(standard: str) -> list:
    """The scan files for one standard, as (key, label), grouped by country.

    Labels come back as "United Kingdom: uk-Aberdare"; the code before the
    colon is dropped from the transmitter, which already says where it is.
    """
    if standard not in BY_ID:
        raise TunerError(f"unknown standard: {standard}")
    reply = call("dvb/scanfile/list", {"type": standard})
    out = []
    for entry in reply.get("entries", []):
        label = entry.get("val", entry.get("key", ""))
        country, _, place = label.partition(":")
        place = place.strip()
        if "-" in place:
            place = place.split("-", 1)[1]
        out.append({"key": entry["key"], "country": country.strip(),
                    "place": place.replace("_", " ") or label})
    out.sort(key=lambda r: (r["country"].lower(), r["place"].lower()))
    return out


def write_progress(**state) -> None:
    PROGRESS.parent.mkdir(parents=True, exist_ok=True)
    temporary = PROGRESS.with_suffix(".tmp")
    temporary.write_text(json.dumps({**state, "at": time.time()}))
    temporary.replace(PROGRESS)


def progress() -> dict:
    try:
        return json.loads(PROGRESS.read_text())
    except (OSError, ValueError):
        return {"state": "idle"}


def network_summary(uuid: str) -> dict:
    grid = call("mpegts/network/grid", {"limit": 200})
    for entry in grid.get("entries", []):
        if entry.get("uuid") == uuid:
            return entry
    return {}


def muxes(network_uuid: str) -> list:
    grid = call("mpegts/mux/grid", {"limit": 5000})
    return [m for m in grid.get("entries", [])
            if m.get("network_uuid", network_uuid) == network_uuid]


def scan_finished(mux_list: list) -> bool:
    """Every mux has been tried. 1 is pending and 3 is scanning now."""
    return bool(mux_list) and not any(m.get("scan_state") in (1, 3)
                                      for m in mux_list)


def create_network(network_class: str, name: str, conf: dict) -> str:
    reply = call("mpegts/network/create",
                 {"class": network_class,
                  "conf": json.dumps({"networkname": name, **conf})})
    uuid = reply.get("uuid")
    if not uuid:
        raise TunerError("the tuner service did not create the network")
    return uuid


def attach(network_uuid: str, frontend_class: str) -> int:
    """Point every tuner of the right kind at the network. Returns how many."""
    count = 0
    for fe in frontends():
        if fe["class"] != frontend_class:
            continue
        current = call("idnode/load", {"uuid": fe["uuid"]})
        entry = (current.get("entries") or [{}])[0]
        networks = []
        for p in entry.get("params", []):
            if p.get("id") == "networks":
                networks = list(p.get("value") or [])
        if network_uuid not in networks:
            networks.append(network_uuid)
        call("idnode/save", {"node": json.dumps(
            {"uuid": fe["uuid"], "enabled": True, "networks": networks})})
        count += 1
    return count


def map_services(network_uuid: str) -> int:
    """Turn every found service on the network into a channel.

    Services name their network rather than carrying its id, so they are
    matched on the name. Matching on an id that is not there took every service
    on the box, which on a second scan would remap the other networks' channels.
    """
    name = network_summary(network_uuid).get("networkname", "")
    grid = call("mpegts/service/grid", {"limit": 5000})
    uuids = [s["uuid"] for s in grid.get("entries", [])
             if s.get("network") == name]
    if uuids:
        call("service/mapper/save", {"node": json.dumps({
            "services": uuids, "encrypted": False, "merge_same_name": False,
            "check_availability": False, "type_tags": True,
            "provider_tags": False, "network_tags": False})})
    return len(uuids)


def add_to_livetv() -> None:
    loader = importlib.machinery.SourceFileLoader("freetvos_livetv", LIVETV_CMD)
    spec = importlib.util.spec_from_loader(loader.name, loader)
    livetv = importlib.util.module_from_spec(spec)
    loader.exec_module(livetv)
    livetv.add_source({"kind": "m3u", "label": "Tuner in this box",
                       "playlist": LIVETV_PLAYLIST, "guide": LIVETV_GUIDE})


def scan(standard: str, scanfile: str, iptv_url: str = "",
         timeout: float = SCAN_TIMEOUT, poll: float = 3) -> dict:
    """The whole setup: network, tuners, scan, channels, Live TV."""
    write_progress(state="starting", muxes=0, done=0, services=0, channels=0)
    try:
        if iptv_url:
            # No tuner at all: the same scan and mapping, against a playlist.
            # This is how the path after the tuner is tested without hardware.
            net = create_network("iptv_auto_network", "Test tuner",
                                 {"url": iptv_url, "max_streams": 2})
            attached = 0
        else:
            if standard not in BY_ID:
                raise TunerError(f"unknown standard: {standard}")
            std = BY_ID[standard]
            net = create_network(std["network"],
                                 f"{std['name']} ({std['where'].split(',')[0]})",
                                 {"scanfile": scanfile, "skipinitscan": False})
            attached = attach(net, std["frontend"])
            if attached == 0:
                raise TunerError("no tuner of that kind is plugged in")
            call("mpegts/network/scan", {"uuid": net})

        deadline = time.time() + timeout
        while True:
            found = muxes(net)
            summary = network_summary(net)
            done = sum(1 for m in found if m.get("scan_state") not in (1, 3))
            write_progress(state="scanning", muxes=len(found), done=done,
                           services=summary.get("num_svc", 0),
                           channels=summary.get("num_chn", 0), tuners=attached)
            if scan_finished(found) and summary.get("scanq_length", 0) == 0:
                break
            if time.time() > deadline:
                raise TunerError("the scan did not finish in twenty minutes")
            time.sleep(poll)

        services = map_services(net)
        # Mapping finishes a few seconds after TVHeadend accepts it. Reporting
        # straight away said "0 channels", and adding the tuner to Live TV that
        # early left the guide empty until its next refresh.
        channels = 0
        if services:
            settle = time.time() + 60
            while time.time() < settle:
                channels = network_summary(net).get("num_chn", 0)
                write_progress(state="scanning", muxes=len(found), done=len(found),
                               services=services, channels=channels, tuners=attached)
                if channels >= services:
                    break
                time.sleep(poll)
            add_to_livetv()
        result = dict(state="done", muxes=len(found), done=len(found),
                      services=services, channels=channels, tuners=attached)
        write_progress(**result)
        return result
    except TunerError as exc:
        write_progress(state="failed", error=str(exc))
        raise


# ---------------------------------------------------------------------------
# Commands.
# ---------------------------------------------------------------------------


def cmd_status(_args) -> int:
    present = tuners_present()
    print(f"option:       {'on' if enabled() else 'off'}")
    print(f"service:      {'running' if running() else 'stopped'}")
    print(f"tuners seen:  {', '.join(present) if present else 'none'}")
    if running():
        for fe in frontends():
            print(f"  usable:     {fe['name']} ({fe['class'].split('_', 2)[-1]})")
    return 0


def cmd_toggle(args) -> int:
    try:
        set_enabled(args.cmd == "on")
    except TunerError as exc:
        print(exc, file=sys.stderr)
        return 1
    print(f"tuner support {args.cmd}")
    return 0


def cmd_standards(_args) -> int:
    for s in STANDARDS:
        print(f"{s['id']:7} {s['name']:8} {s['where']}")
    return 0


def cmd_regions(args) -> int:
    try:
        for r in regions(args.standard):
            print(f"{r['key']}\t{r['country']}\t{r['place']}")
    except TunerError as exc:
        print(exc, file=sys.stderr)
        return 1
    return 0


def cmd_scan(args) -> int:
    try:
        result = scan(args.standard, args.scanfile or "", args.iptv_url or "")
    except TunerError as exc:
        print(exc, file=sys.stderr)
        return 1
    print(f"{result['channels']} channels from {result['muxes']} frequencies")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="freetvos-tuner", description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="cmd")
    sub.add_parser("status").set_defaults(func=cmd_status)
    for name in ("on", "off"):
        sub.add_parser(name).set_defaults(func=cmd_toggle)
    sub.add_parser("standards").set_defaults(func=cmd_standards)
    p = sub.add_parser("regions")
    p.add_argument("standard")
    p.set_defaults(func=cmd_regions)
    p = sub.add_parser("scan")
    p.add_argument("standard")
    p.add_argument("scanfile", nargs="?")
    p.add_argument("--iptv-url", help=argparse.SUPPRESS)
    p.set_defaults(func=cmd_scan)
    args = parser.parse_args()
    if not args.cmd:
        parser.print_help()
        return 2
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
