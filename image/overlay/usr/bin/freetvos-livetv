#!/usr/bin/env python3
"""Live TV: channels and a programme guide, from Tunarr, a tuner, or a playlist.

Point it at what serves live TV on the network and it becomes channels you flip
through with a remote, with a guide of what is on now and next.

  freetvos-livetv browse                   the guide, which is what the tile opens
  freetvos-livetv watch [NUMBER]           full screen, on a channel or the last one
  freetvos-livetv channels                 every channel and what is on it now
  freetvos-livetv add-tunarr ADDRESS       Tunarr, ErsatzTV, anything at /api/channels.m3u
  freetvos-livetv add-m3u PLAYLIST [--guide XMLTV]
  freetvos-livetv add-hdhomerun ADDRESS [--guide XMLTV]
  freetvos-livetv sources
  freetvos-livetv remove N

Tunarr turns a Plex or Jellyfin library into channels on a schedule, and
presents them both as an M3U playlist with an XMLTV guide and as an HDHomeRun
tuner. Either works here. A real HDHomeRun, TVHeadend and IPTV services come in
through the same two doors.
"""
import argparse
import datetime as dt
import json
import os
import sys
import tempfile
import time
from pathlib import Path

sys.path.insert(0, "/usr/share/freetvos")
sys.path.insert(0, "/usr/share/freetvos/livetv")

import guide                                                # noqa: E402

CONF_HOME = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
CACHE_HOME = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache"))
SETTINGS = Path(os.environ.get("FREETVOS_LIVETV_CONF",
                               CONF_HOME / "freetvos/livetv.json"))
CACHE = Path(os.environ.get("FREETVOS_LIVETV_CACHE",
                            CACHE_HOME / "freetvos/livetv"))
PLAYER = os.environ.get("FREETVOS_LIVETV_PLAYER",
                        "/usr/bin/freetvos-livetv-player")

# Channel lists change when someone edits a schedule; guides are regenerated by
# the server every hour or so. Asking more often than that only slows the page.
PLAYLIST_EVERY = 30 * 60
GUIDE_EVERY = 60 * 60
GUIDE_HOURS = 6


# ---------------------------------------------------------------------------
# Settings.
# ---------------------------------------------------------------------------


def settings() -> dict:
    try:
        stored = json.loads(SETTINGS.read_text())
    except (OSError, ValueError):
        stored = {}
    return {"sources": stored.get("sources") or [],
            "last": stored.get("last") or {}}


def save(data: dict) -> None:
    SETTINGS.parent.mkdir(parents=True, exist_ok=True)
    temporary = SETTINGS.with_suffix(".tmp")
    temporary.write_text(json.dumps(data, indent=2) + "\n")
    temporary.replace(SETTINGS)


def add_source(source: dict) -> dict:
    data = settings()
    key = (source.get("kind"), source.get("playlist") or source.get("address"))
    data["sources"] = [s for s in data["sources"]
                       if (s.get("kind"), s.get("playlist") or s.get("address")) != key]
    data["sources"].append(source)
    save(data)
    forget_cache()
    return data


def remove_source(index: int) -> dict:
    data = settings()
    if 0 <= index < len(data["sources"]):
        data["sources"].pop(index)
        save(data)
        forget_cache()
    return data


def tunarr_source(address: str) -> dict:
    base = guide.normalise_address(address)
    return {"kind": "m3u", "label": f"Tunarr at {base}",
            "playlist": f"{base}/api/channels.m3u",
            "guide": f"{base}/api/xmltv.xml"}


def remember_last(channel: dict) -> None:
    data = settings()
    data["last"] = {"number": channel.get("number", ""),
                    "name": channel.get("name", ""),
                    "url": channel.get("url", "")}
    save(data)


# ---------------------------------------------------------------------------
# Reading every source into one list of channels.
# ---------------------------------------------------------------------------


def forget_cache() -> None:
    for f in (CACHE / "lineup.json",):
        try:
            f.unlink()
        except OSError:
            pass


def _fetch_source(source: dict) -> tuple:
    """(channels, guide address) for one configured source."""
    if source.get("kind") == "hdhomerun":
        found = guide.hdhomerun(source["address"])
        return found["channels"], source.get("guide", "")
    raw = guide._get(source["playlist"]).decode("utf-8", "replace")
    playlist = guide.parse_m3u(raw)
    return playlist["channels"], source.get("guide") or playlist["guide"]


def lineup(force: bool = False, now: dt.datetime = None) -> dict:
    """Every channel from every source, sorted, with its guide attached.

    Cached on disk, so opening the guide twice in a minute does not mean asking
    the server twice, and so a server that has gone away still leaves the last
    channel list on screen with a note, rather than an empty page.
    """
    now = now or dt.datetime.now(dt.timezone.utc)
    cache_file = CACHE / "lineup.json"
    if not force:
        try:
            cached = json.loads(cache_file.read_text())
            if time.time() - cached.get("fetched", 0) < PLAYLIST_EVERY:
                return _thaw(cached)
        except (OSError, ValueError):
            pass

    channels, errors = [], []
    for source in settings()["sources"]:
        try:
            found, guide_url = _fetch_source(source)
        except guide.GuideError as exc:
            errors.append(f"{source.get('label') or source.get('playlist') or source.get('address')}: {exc}")
            continue
        parsed = {"channels": {}, "programmes": {}}
        if guide_url:
            try:
                parsed = guide.parse_xmltv(guide._get(guide_url))
            except guide.GuideError as exc:
                errors.append(f"guide: {exc}")
        matched = guide.match_guide(found, parsed)
        horizon_start = now - dt.timedelta(hours=1)
        horizon_end = now + dt.timedelta(hours=GUIDE_HOURS)
        for index, channel in enumerate(found):
            shows = parsed["programmes"].get(matched.get(index, ""), [])
            channel["shows"] = guide.window(shows, horizon_start, horizon_end)
            channels.append(channel)

    result = {"fetched": time.time(), "channels": guide.sort_channels(channels),
              "errors": errors}
    if channels or not cache_file.exists():
        CACHE.mkdir(parents=True, exist_ok=True)
        cache_file.write_text(json.dumps(_freeze(result)))
    elif cache_file.exists():
        # Nothing came back at all. Keep the last list, and say why.
        try:
            stale = _thaw(json.loads(cache_file.read_text()))
            stale["errors"] = errors + ["showing the last channel list"]
            return stale
        except (OSError, ValueError):
            pass
    return result


def _freeze(result: dict) -> dict:
    out = json.loads(json.dumps(result, default=str))
    for channel, original in zip(out["channels"], result["channels"]):
        channel["shows"] = [{**show, "start": s["start"].isoformat(),
                             "stop": s["stop"].isoformat()}
                            for show, s in zip(channel["shows"], original["shows"])]
    return out


def _thaw(cached: dict) -> dict:
    for channel in cached.get("channels", []):
        for show in channel.get("shows", []):
            show["start"] = dt.datetime.fromisoformat(show["start"])
            show["stop"] = dt.datetime.fromisoformat(show["stop"])
    return cached


def find_channel(channels: list, number: str) -> int:
    for index, channel in enumerate(channels):
        if channel.get("number") == str(number):
            return index
    return -1


def start_index(channels: list, number: str = "") -> int:
    if number:
        found = find_channel(channels, number)
        if found >= 0:
            return found
    last = settings()["last"]
    for index, channel in enumerate(channels):
        if last and channel.get("url") == last.get("url"):
            return index
    found = find_channel(channels, last.get("number", "")) if last else -1
    return max(found, 0)


def watch(number: str = "", channels: list = None, index: int = -1) -> int:
    """Hand the player the channel list and where to start, then step aside."""
    channels = channels if channels is not None else lineup()["channels"]
    if not channels:
        print("no channels: add a source first", file=sys.stderr)
        return 1
    CACHE.mkdir(parents=True, exist_ok=True)
    handoff = CACHE / "watching.json"
    handoff.write_text(json.dumps(_freeze({"channels": channels,
                                           "fetched": time.time(),
                                           "errors": []})))
    # By position when the guide knows it. Playlists without channel numbers
    # are common, and tuning by an empty number would land on whatever was
    # watched last instead of what was chosen.
    start = index if 0 <= index < len(channels) else start_index(channels, number)
    argv = [PLAYER, "--channels", str(handoff), "--start", str(start)]
    os.execv(argv[0], argv)
    return 0


# ---------------------------------------------------------------------------
# Commands.
# ---------------------------------------------------------------------------


def cmd_channels(args) -> int:
    result = lineup(force=args.refresh)
    now = dt.datetime.now(dt.timezone.utc)
    for message in result["errors"]:
        print(f"! {message}", file=sys.stderr)
    if not result["channels"]:
        print("no channels")
        return 1
    for channel in result["channels"]:
        current, _ = guide.on_now(channel.get("shows"), now)
        on = current["title"] if current else ""
        print(f"{channel['number']:>6}  {channel['name'][:30]:30}  {on}")
    return 0


def cmd_sources(_args) -> int:
    sources = settings()["sources"]
    if not sources:
        print("no sources")
        return 1
    for index, source in enumerate(sources):
        where = source.get("playlist") or source.get("address")
        print(f"{index}  {source.get('kind'):9}  {where}  {source.get('guide', '')}")
    return 0


def cmd_add_tunarr(args) -> int:
    add_source(tunarr_source(args.address))
    return cmd_channels(argparse.Namespace(refresh=True))


def cmd_add_m3u(args) -> int:
    add_source({"kind": "m3u", "label": args.playlist,
                "playlist": args.playlist, "guide": args.guide or ""})
    return cmd_channels(argparse.Namespace(refresh=True))


def cmd_add_hdhomerun(args) -> int:
    add_source({"kind": "hdhomerun", "label": args.address,
                "address": guide.normalise_address(args.address, 80),
                "guide": args.guide or ""})
    return cmd_channels(argparse.Namespace(refresh=True))


def cmd_remove(args) -> int:
    remove_source(args.index)
    return cmd_sources(args)


def cmd_watch(args) -> int:
    return watch(args.number or "", index=args.index)


def cmd_remember_last(args) -> int:
    """Called by the player on every channel change, for next time."""
    try:
        remember_last(json.loads(args.channel))
    except ValueError:
        return 2
    return 0


def cmd_browse(_args) -> int:
    import livetvui
    return livetvui.run(sys.modules[__name__])


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="freetvos-livetv", description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="cmd")
    sub.add_parser("browse").set_defaults(func=cmd_browse)
    p = sub.add_parser("channels")
    p.add_argument("--refresh", action="store_true")
    p.set_defaults(func=cmd_channels)
    sub.add_parser("sources").set_defaults(func=cmd_sources)
    p = sub.add_parser("watch")
    p.add_argument("number", nargs="?")
    p.add_argument("--index", type=int, default=-1, help=argparse.SUPPRESS)
    p.set_defaults(func=cmd_watch)
    p = sub.add_parser("add-tunarr")
    p.add_argument("address")
    p.set_defaults(func=cmd_add_tunarr)
    p = sub.add_parser("add-m3u")
    p.add_argument("playlist")
    p.add_argument("--guide")
    p.set_defaults(func=cmd_add_m3u)
    p = sub.add_parser("add-hdhomerun")
    p.add_argument("address")
    p.add_argument("--guide")
    p.set_defaults(func=cmd_add_hdhomerun)
    p = sub.add_parser("remember-last", help=argparse.SUPPRESS)
    p.add_argument("channel")
    p.set_defaults(func=cmd_remember_last)
    p = sub.add_parser("remove")
    p.add_argument("index", type=int)
    p.set_defaults(func=cmd_remove)
    args = parser.parse_args()
    if not args.cmd:
        parser.print_help()
        return 2
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
