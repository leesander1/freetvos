#!/usr/bin/env bash
# Show two or four services at once, with sound following the focused pane.
#
#   freetvos-split pick   choose on screen what goes in each pane
#   freetvos-split toggle  side by side, or back to one
#   freetvos-split 1      one service, fullscreen
#   freetvos-split 2      two side by side
#   freetvos-split 4      four in a grid
#   freetvos-split next   move focus, and the sound, to the next pane
#   freetvos-split launch <id>   open a saved combo and tile it
#   freetvos-split list   show which services are on screen
#   freetvos-split pip [pick]   one big and one small picture; pick asks which
#   freetvos-split pip-swap     swap the big and small pictures
#   freetvos-split pip-corner   move the small picture to the next corner
#   freetvos-split pip-off      back to one picture
#
# The same shortcuts work directly from a keyboard: Ctrl+Alt+1, 2, 4 and Tab.
#
# The window placement itself lives in the KWin script at
# /usr/share/kwin/scripts/freetvos-split, because on Wayland only the
# compositor may move a window. This command triggers that script's own
# shortcut and then handles the audio, which a KWin script cannot reach.
set -euo pipefail

STATE_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/freetvos"
mkdir -p "$STATE_DIR"

die() { echo "$*" >&2; exit 1; }

# Which services are on screen, ordered by process id. The KWin script orders
# its panes the same way, which is how the two halves agree on which pane is
# first without any channel between them.
running_apps() {
  {
  for pid in $(pgrep -f -- "--class=freetvos-" 2>/dev/null || true); do
    # Pull the token out of the command line rather than expecting it on a
    # line of its own. Chromium rewrites its process title, so /proc/PID/cmdline
    # is one space-separated blob with no NUL separators: splitting on NUL
    # yields a single line, which an unanchored grep returns whole and an
    # anchored grep never matches. Extracting the token works either way.
    cls="$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null \
           | grep -oE -m1 -- '--class=freetvos-[a-z0-9-]+' | head -1 || true)"
    [ -n "$cls" ] || continue
    # Chromium's helper processes inherit the flag; only the browser process
    # has a window, and it is the one whose parent does not share the flag.
    # The picker is a service window by class but is not a pane. Without this
    # it gets tiled alongside the services, and two pickers left running end up
    # tiled against each other.
    case "$cls" in --class=freetvos-picker|--class=freetvos-ui) continue ;; esac
    ppid="$(awk '{print $4}' "/proc/$pid/stat" 2>/dev/null || echo 1)"
    grep -qa -- "--class=freetvos-" "/proc/$ppid/cmdline" 2>/dev/null && continue
    echo "${cls#--class=} $pid"
  done
  # An external input is an mpv window, not a Chromium one, so it carries no
  # class to match on. Its control socket is a name this system chose, which
  # makes it a steadier handle than a window title the player is free to
  # rewrite.
  for pid in $(pgrep -f -- "--input-ipc-server=.*freetvos/hdmi-ipc.sock" \
               2>/dev/null || true); do
    echo "freetvos-hdmi $pid"
  done
  # Live TV is an mpv window too, found the same way.
  for pid in $(pgrep -f -- "--input-ipc-server=.*freetvos/livetv-ipc.sock" \
               2>/dev/null || true); do
    echo "freetvos-livetv $pid"
  done
  } | sort -u -k2,2n
}

# Exact, not a substring. pgrep -f matches anywhere in the command line, so
# "freetvos-youtube" also matches "freetvos-youtubetv"; comparing against the
# tokens running_apps already extracts avoids inventing a second, subtly
# different rule for the same question.
is_running() {
  running_apps | awk '{print $1}' | grep -qx -- "freetvos-$1"
}

invoke_shortcut() {
  local name="$1"
  busctl --user call org.kde.kglobalaccel /component/kwin \
    org.kde.kglobalaccel.Component invokeShortcut s "$name" >/dev/null 2>&1 \
    || die "could not reach the split-view script; is the session running?"
}

# Silence every service except one. Each pane is a separate Chromium process,
# so streams cannot be told apart by application name, which is "Chromium" for
# all of them; they are matched on the owning process id instead.
route_audio_to() {
  local want_pid="$1" want_app="${2:-}"
  command -v wpctl >/dev/null 2>&1 || return 0
  local ids
  ids="$(wpctl status 2>/dev/null | sed -n '/Streams:/,/^$/p' \
        | grep -oE '[0-9]+\.' | tr -d '.' || true)"
  [ -n "$ids" ] || return 0
  for id in $ids; do
    local info spid is_input=no want=no
    info="$(wpctl inspect "$id" 2>/dev/null || true)"
    spid="$(printf '%s\n' "$info" \
           | sed -n 's/.*application\.process\.id = "\([0-9]*\)".*/\1/p' | head -1)"
    # An external input's sound is bridged by the audio server itself, so the
    # stream belongs to no application and has no process id to be matched on.
    # The bridge is tagged when it is created, and that tag is the handle.
    printf '%s\n' "$info" | grep -q 'freetvos-hdmi' && is_input=yes
    if [ "$want_app" = "freetvos-hdmi" ]; then
      [ "$is_input" = yes ] && want=yes
    elif [ "$is_input" = no ] && [ -n "$spid" ] && [ "$spid" = "$want_pid" ]; then
      want=yes
    fi
    if [ "$want" = yes ]; then
      wpctl set-mute "$id" 0 >/dev/null 2>&1 || true
    else
      wpctl set-mute "$id" 1 >/dev/null 2>&1 || true
    fi
  done
}

audio_follow_active() {
  # The compositor knows which pane is focused; this side does not. Rather than
  # inventing a channel, take the first pane after a layout change and the next
  # one in the same class order the script uses, which is how both halves stay
  # in agreement without talking.
  local index="$1"
  mapfile -t panes < <(running_apps)
  [ "${#panes[@]}" -gt 0 ] || return 0
  index=$(( index % ${#panes[@]} ))
  local pid="${panes[$index]##* }"
  local app="${panes[$index]%% *}"
  route_audio_to "$pid" "$app"
  echo "$index" > "$STATE_DIR/split-focus"
  echo "sound: ${panes[$index]%% *}"
}

case "${1:-}" in
  toggle)
    # One tile, two states. Two or more services on screen means the viewer
    # wants them side by side; anything else means go back to one.
    n="$(running_apps | wc -l | tr -d ' ')"
    if [ -r "$STATE_DIR/split-on" ]; then
      rm -f "$STATE_DIR/split-on"
      invoke_shortcut "FreeTVOS Single Pane"; audio_follow_active 0
    elif [ "$n" -ge 2 ]; then
      : > "$STATE_DIR/split-on"
      invoke_shortcut "FreeTVOS Two Panes"; audio_follow_active 0
    else
      echo "Open a second service first; split view needs two." >&2
      command -v kdialog >/dev/null 2>&1 && kdialog --title "Split View" \
        --sorry "Open a second service first. Split view needs two." &
      exit 3
    fi
    ;;
  1) rm -f "$STATE_DIR/split-on"; invoke_shortcut "FreeTVOS Single Pane"; audio_follow_active 0 ;;
  2) : > "$STATE_DIR/split-on"; invoke_shortcut "FreeTVOS Two Panes";  audio_follow_active 0 ;;
  4) : > "$STATE_DIR/split-on"; invoke_shortcut "FreeTVOS Four Panes"; audio_follow_active 0 ;;
  next)
    invoke_shortcut "FreeTVOS Next Pane"
    current=0
    [ -r "$STATE_DIR/split-focus" ] && current="$(cat "$STATE_DIR/split-focus")"
    audio_follow_active $(( current + 1 ))
    ;;
  pick)
    # Ask on screen which services go in which pane, then do it. This is what
    # the Split View tile runs: toggling only helps once two services are
    # already open, which assumes the viewer knew to open them first.
    # One picker at a time. A second instance receives the remote's keypresses
    # alongside the first, and both end up on screen.
    pkill -f -- "--class=freetvos-picker" 2>/dev/null || true
    pkill -f "/usr/bin/freetvos-pick" 2>/dev/null || true
    sleep 1

    out="$(/usr/bin/freetvos-pick || true)"
    [ -n "$out" ] || exit 0
    apps="$(printf '%s\n' "$out" | head -1)"
    wants_save="$(printf '%s\n' "$out" | sed -n '2p')"

    for app in $apps; do
      if ! is_running "$app"; then
        FREETVOS_QUIET=1 setsid /usr/bin/freetvos-webapp "$app" \
          >"$STATE_DIR/launch-$app.log" 2>&1 < /dev/null &
      fi
    done
    want="$(echo "$apps" | wc -w | tr -d ' ')"
    for _ in $(seq 1 40); do
      [ "$(running_apps | wc -l | tr -d ' ')" -ge "$want" ] && break
      sleep 0.5
    done
    sleep 1.5

    : > "$STATE_DIR/split-on"
    invoke_shortcut "FreeTVOS Two Panes"
    audio_follow_active 0

    if [ "$wants_save" = "SAVE" ]; then
      /usr/bin/freetvos-combo add --apps "$apps" >/dev/null 2>&1 \
        && echo "saved as a quick launch tile"
    fi
    ;;
  launch)
    # Open a saved set of services and tile them in one action.
    id="${2:-}"; [ -n "$id" ] || die "which combo?"
    combo="${XDG_CONFIG_HOME:-$HOME/.config}/freetvos/combos.d/$id.combo"
    [ -r "$combo" ] || die "no such combo: $id"
    NAME=""; APPS=""; LAYOUT=2
    # shellcheck disable=SC1090
    . "$combo"

    for app in $APPS; do
      # Already running is the common case when a combo is selected twice;
      # launching a second copy would put two panes of the same service on
      # screen and confuse the pane ordering.
      if ! is_running "$app"; then
        # Kept, not discarded. Sending this to /dev/null is why a service that
        # refused to start looked like it was merely slow: the reason was
        # written and thrown away.
        FREETVOS_QUIET=1 setsid /usr/bin/freetvos-webapp "$app" \
          >"$STATE_DIR/launch-$app.log" 2>&1 < /dev/null &
      fi
    done

    # Wait for the windows to map. Tiling before they exist finds nothing and
    # silently does nothing. Sixty seconds because a cold profile on modest
    # hardware is genuinely slow, and giving up early looks like a failure.
    for _ in $(seq 1 120); do
      missing=""
      for app in $APPS; do
        is_running "$app" || missing="$missing $app"
      done
      [ -z "$missing" ] && break
      sleep 0.5
    done
    sleep 1.5

    if [ -n "$missing" ]; then
      # Name what did not start, and why if it said. A pane that never appears
      # with no explanation is the worst outcome; this is the whole reason the
      # output above is kept.
      for app in $missing; do
        reason="$(head -1 "$STATE_DIR/launch-$app.log" 2>/dev/null)"
        echo "did not start:$app ${reason:+- $reason}" >&2
      done
      first="${missing# }"; first="${first%% *}"
      reason="$(head -1 "$STATE_DIR/launch-$first.log" 2>/dev/null)"
      command -v kdialog >/dev/null 2>&1 && kdialog --title "Split View" \
        --sorry "${reason:-$first did not start.}" &
    fi

    : > "$STATE_DIR/split-on"
    case "$LAYOUT" in
      4) invoke_shortcut "FreeTVOS Four Panes" ;;
      *) invoke_shortcut "FreeTVOS Two Panes" ;;
    esac
    audio_follow_active 0
    ;;
  pip|pip-swap|pip-corner|pip-off)
    big_file="$STATE_DIR/pip-big"
    if [ "$1" = "pip" ]; then
      big_app=""
      if [ "${2:-}" = "pick" ]; then
        # Same picker as split view, asking for the big picture then the small.
        pkill -f -- "--class=freetvos-picker" 2>/dev/null || true
        pkill -f "/usr/bin/freetvos-pick" 2>/dev/null || true
        sleep 1
        out="$(FREETVOS_PICK_MODE=pip /usr/bin/freetvos-pick || true)"
        [ -n "$out" ] || exit 0
        apps="$(printf '%s\n' "$out" | head -1)"
        for app in $apps; do
          if ! is_running "$app"; then
            FREETVOS_QUIET=1 setsid /usr/bin/freetvos-webapp "$app" \
              >"$STATE_DIR/launch-$app.log" 2>&1 < /dev/null &
          fi
        done
        for _ in $(seq 1 120); do
          [ "$(running_apps | wc -l | tr -d ' ')" -ge 2 ] && break
          sleep 0.5
        done
        sleep 2
        big_app="freetvos-${apps%% *}"
      fi
      mapfile -t panes < <(running_apps)
      if [ "${#panes[@]}" -lt 2 ]; then
        echo "Picture in picture needs two things on screen." >&2
        command -v kdialog >/dev/null 2>&1 && kdialog --title "Picture in Picture" \
          --sorry "Open a second service first. Picture in picture needs two." &
        exit 3
      fi
      # The script orders panes by process id, as running_apps does, so the
      # position here is the position there.
      index=0
      [ -n "$big_app" ] && [ "${panes[1]%% *}" = "$big_app" ] && index=1
      rm -f "$STATE_DIR/split-on"
      if [ "$index" = 1 ]; then
        invoke_shortcut "FreeTVOS PiP Second Big"
      else
        invoke_shortcut "FreeTVOS PiP First Big"
      fi
      echo "${panes[$index]##* }" > "$big_file"
    elif [ "$1" = "pip-swap" ]; then
      invoke_shortcut "FreeTVOS Swap Picture"
      mapfile -t panes < <(running_apps)
      was="$(cat "$big_file" 2>/dev/null || true)"
      for pane in "${panes[@]:0:2}"; do
        [ "${pane##* }" != "$was" ] && echo "${pane##* }" > "$big_file" && break
      done
    elif [ "$1" = "pip-corner" ]; then
      invoke_shortcut "FreeTVOS Move Picture"
    else
      invoke_shortcut "FreeTVOS Picture In Picture"
    fi
    # Whichever picture is big has the remote, and gets the sound.
    big_pid="$(cat "$big_file" 2>/dev/null || true)"
    if [ -n "$big_pid" ]; then
      app="$(running_apps | awk -v p="$big_pid" '$2 == p {print $1}' | head -1)"
      route_audio_to "$big_pid" "$app"
      [ "$1" = "pip-off" ] && rm -f "$big_file"
    fi
    ;;
  list) running_apps ;;
  *) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
