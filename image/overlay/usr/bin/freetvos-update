#!/usr/bin/env python3
"""Keep the television up to date: download new versions, restart at night.

The whole system is one container image, published by the build each time it
changes. bootc downloads a new one beside the running one and switches to it on
the next start, keeping settings, logins and everything else under /var and
/etc. So an update is two steps: download, which can happen whenever, and a
restart, which must not happen in the middle of a film. Downloads happen when
the timer fires; restarts only between RESTART_FROM and RESTART_UNTIL, and only
while nothing is playing. Missed that window, an update waits and finishes the
next time the television is restarted anyway.

  freetvos-update show      the page, which is what the Updates tile opens
  freetvos-update status    this version, whether a new one waits, the last check
  freetvos-update on        switch automatic updates on (the default)
  freetvos-update off       switch them off

Run by systemd, as root:

  freetvos-update auto      the timer: check, download, restart if it is night
  freetvos-update check     check and download now, never restart ("Check now")
  freetvos-update record    write down what is running, at boot

The switch lives in the television account's own settings, so the page can
change it without asking for a password; the root side only reads it. The
state the page shows is written by the root side to STATUS, which anyone can
read, because only root may ask bootc.
"""
import argparse
import datetime as dt
import fcntl
import json
import os
import pwd
import re
import subprocess
import sys
import time
from pathlib import Path

TV_USER = os.environ.get("FREETVOS_TV_USER", "tv")
STATUS = Path(os.environ.get("FREETVOS_UPDATE_STATUS",
                             "/var/lib/freetvos/update-status.json"))
LOCK = Path("/run/freetvos-update.lock")
REQUEST_NAME = "update-request"

# Restarting to finish an update: from 2 until 5:30 in the morning.
RESTART_FROM = dt.time(2, 0)
RESTART_UNTIL = dt.time(5, 30)
# While something plays inside that window, look again this often.
RECHECK_SECONDS = 600
UPGRADE_TIMEOUT = 3 * 3600


# ---------------------------------------------------------------------------
# The switch.
# ---------------------------------------------------------------------------


def config_dir() -> Path:
    """The television account's settings folder, whoever is asking."""
    if os.environ.get("FREETVOS_UPDATE_CONFIG"):
        return Path(os.environ["FREETVOS_UPDATE_CONFIG"])
    if os.geteuid() == 0:
        try:
            home = Path(pwd.getpwnam(TV_USER).pw_dir)
        except KeyError:
            home = Path("/var/home") / TV_USER
        return home / ".config/freetvos"
    base = os.environ.get("XDG_CONFIG_HOME") or str(Path.home() / ".config")
    return Path(base) / "freetvos"


def settings_path() -> Path:
    return config_dir() / "updates.json"


def enabled() -> bool:
    """On unless switched off. A file that cannot be read leaves them on:
    a television that silently stops updating is worse than one that updates."""
    try:
        data = json.loads(settings_path().read_text())
    except (OSError, ValueError):
        return True
    return not (isinstance(data, dict) and data.get("automatic") is False)


def set_enabled(on: bool) -> None:
    path = settings_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(".tmp")
    tmp.write_text(json.dumps({"automatic": bool(on)}, indent=2) + "\n")
    tmp.replace(path)
    if os.geteuid() == 0:
        try:
            pw = pwd.getpwnam(TV_USER)
            os.chown(path, pw.pw_uid, pw.pw_gid)
        except (KeyError, OSError):
            pass


def check_pending() -> bool:
    """A check was asked for and the root side has not begun it yet."""
    return (config_dir() / REQUEST_NAME).exists()


def request_check() -> None:
    """Ask the root side to check now. A path unit watches for this file."""
    path = config_dir() / REQUEST_NAME
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(str(time.time()))


# ---------------------------------------------------------------------------
# What bootc says.
# ---------------------------------------------------------------------------


def bootc_status() -> dict:
    done = subprocess.run(["bootc", "status", "--format=json"],
                          capture_output=True, text=True, timeout=120)
    if done.returncode != 0:
        raise RuntimeError(done.stderr.strip() or "bootc status failed")
    return json.loads(done.stdout)


def describe(entry) -> dict | None:
    """One deployment, booted or staged, as the page wants it."""
    if not isinstance(entry, dict):
        return None
    image = entry.get("image") or {}
    ref = image.get("image") or {}
    return {
        "image": ref.get("image", ""),
        "version": image.get("version") or "",
        "built": image.get("timestamp") or "",
        "digest": image.get("imageDigest", ""),
    }


def tracking(host: dict) -> str:
    """The published image this television follows, or "" if none.

    Installed from a USB stick without being pointed anywhere, a system
    follows the copy on the stick, which cannot be downloaded again.
    """
    spec = (host.get("spec") or {}).get("image") or {}
    ref = spec.get("image", "")
    if spec.get("transport", "registry") != "registry":
        return ""
    if not ref or ref.startswith("localhost/"):
        return ""
    return ref


def summarise(host: dict) -> dict:
    status = host.get("status") or {}
    booted = describe(status.get("booted"))
    staged = describe(status.get("staged"))
    if staged and booted and staged["digest"] == booted["digest"]:
        staged = None
    return {"tracking": tracking(host), "booted": booted, "staged": staged}


# ---------------------------------------------------------------------------
# The status file the page reads.
# ---------------------------------------------------------------------------


def read_status() -> dict:
    try:
        data = json.loads(STATUS.read_text())
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def write_status(**changes) -> dict:
    data = read_status()
    data.update(changes)
    data["automatic"] = enabled()
    STATUS.parent.mkdir(parents=True, exist_ok=True)
    tmp = STATUS.with_suffix(".tmp")
    tmp.write_text(json.dumps(data, indent=2) + "\n")
    tmp.chmod(0o644)
    tmp.replace(STATUS)
    return data


def now_iso() -> str:
    return dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds")


def record() -> dict:
    try:
        return write_status(checking=False, phase="", **summarise(bootc_status()))
    except (RuntimeError, OSError, ValueError, subprocess.TimeoutExpired) as e:
        return write_status(checking=False, result="error", error=str(e)[:300])


# ---------------------------------------------------------------------------
# Checking and restarting.
# ---------------------------------------------------------------------------


def download() -> dict:
    """Ask for a newer image and download it if there is one. Never restarts."""
    try:
        before = summarise(bootc_status())
    except (RuntimeError, OSError, ValueError, subprocess.TimeoutExpired) as e:
        return write_status(checking=False, checked=now_iso(), result="error",
                            error=str(e)[:300])
    if not before["tracking"]:
        return write_status(checking=False, checked=now_iso(),
                            result="unmanaged", error="", **before)
    # Asking first is quick: only the new image's description is fetched. The
    # download itself can be the whole system, gigabytes, and the page must be
    # able to say which of the two is happening rather than "checking" for an
    # hour.
    write_status(checking=True, phase="checking", detail="", **before)
    try:
        asked = subprocess.run(["bootc", "upgrade", "--check"],
                               capture_output=True, text=True, timeout=600)
        if asked.returncode != 0:
            raise RuntimeError(last_line(asked.stderr or asked.stdout)
                               or "bootc upgrade --check failed")
        offered = check_answer(asked.stdout, bootc_status())
    except (RuntimeError, OSError, ValueError, subprocess.TimeoutExpired) as e:
        record()
        return write_status(checked=now_iso(), result="error", error=str(e)[:300])
    if offered is None:
        record()
        return write_status(checked=now_iso(), error="",
                            result="downloaded" if before.get("staged") else "current")

    write_status(phase="downloading", started=now_iso(), detail="",
                 offered=offered)
    failed, reason = fetch()
    after = record()
    if failed:
        return write_status(checked=now_iso(), result="error", error=reason[:300])
    return write_status(checked=now_iso(), error="",
                        result="downloaded" if after.get("staged") else "current")


def last_line(text: str) -> str:
    lines = [line.strip() for line in (text or "").splitlines() if line.strip()]
    return lines[-1] if lines else ""


def waiting_update(host: dict) -> dict | None:
    """The newer image bootc --check found, or None if there is nothing new.

    bootc keeps what it found as the booted deployment's cachedUpdate. One
    that is the running image, or the one already downloaded, is not new.
    """
    status = host.get("status") or {}
    booted = status.get("booted") or {}
    found = describe({"image": booted.get("cachedUpdate")})
    if not found or not found["digest"]:
        return None
    have = {d["digest"] for d in (describe(booted), describe(status.get("staged"))) if d}
    return None if found["digest"] in have else found


def check_answer(output: str, host: dict) -> dict | None:
    """What bootc upgrade --check found: the update, or None for nothing new.

    Read from what it prints, "Update available for: ..." with a Digest line,
    or "No changes in: ...". Not from bootc status's cachedUpdate alone: bootc
    records that only against an image it has already pulled from the same
    address, and a television installed from a USB stick and then pointed at
    the published image has pulled nothing from it yet. Reading cachedUpdate
    alone, such a television said "Up to date" for ever and never updated.

    Output that says neither is treated as an update, so the download runs:
    bootc upgrade finds out for itself, and costs nothing if there is none.
    """
    if re.search(r"^No changes in:", output, re.M):
        return None
    digest = re.search(r"^\s*Digest:\s*(sha256:[0-9a-f]+)", output, re.M)
    version = re.search(r"^\s*Version:\s*(\S+)", output, re.M)
    found = waiting_update(host) or {}
    if digest:
        if found.get("digest") != digest.group(1):
            found = {"image": "", "built": ""}
        found["digest"] = digest.group(1)
    if version and not found.get("version"):
        found["version"] = version.group(1)
    status = host.get("status") or {}
    have = {d["digest"] for d in (describe(status.get("booted")),
                                  describe(status.get("staged"))) if d}
    if found.get("digest") in have:
        return None
    return found


def fetch() -> tuple:
    """Run the download, passing bootc's latest line of progress to the page."""
    try:
        proc = subprocess.Popen(["bootc", "upgrade"], stdout=subprocess.PIPE,
                                stderr=subprocess.STDOUT, text=True, bufsize=1)
    except OSError as e:
        return True, str(e)
    last, shown = "", 0.0
    deadline = time.time() + UPGRADE_TIMEOUT
    for line in proc.stdout:
        line = line.strip()
        if line:
            last = line
        if time.time() - shown > 3 and last:
            write_status(detail=last[:160])
            shown = time.time()
        if time.time() > deadline:
            proc.kill()
            return True, "the download took too long"
    if last:
        write_status(detail=last[:160])
    return proc.wait() != 0, last or "bootc upgrade failed"


def in_window(moment: dt.datetime) -> bool:
    return RESTART_FROM <= moment.time() < RESTART_UNTIL


def sink_inputs_playing(pactl_output: str) -> bool:
    """Whether pactl's list of streams has one that is actually sounding.

    A paused player's stream is corked, and Chromium closes an idle one after
    a few seconds, so an uncorked stream means something is playing now.
    """
    return any(line.strip() == "Corked: no" for line in pactl_output.splitlines())


def playing() -> bool:
    try:
        pw = pwd.getpwnam(TV_USER)
    except KeyError:
        return False
    runtime = f"/run/user/{pw.pw_uid}"
    if not os.path.isdir(runtime):
        return False
    try:
        done = subprocess.run(
            ["runuser", "-u", TV_USER, "--", "env", f"XDG_RUNTIME_DIR={runtime}",
             "pactl", "list", "sink-inputs"],
            capture_output=True, text=True, timeout=20)
    except (OSError, subprocess.TimeoutExpired):
        return False
    return sink_inputs_playing(done.stdout)


def lock():
    """One bootc at a time: the nightly run and Check now can overlap."""
    handle = open(LOCK, "w")
    fcntl.flock(handle, fcntl.LOCK_EX)
    return handle


def safely(step) -> dict:
    """Run a step, and never leave the page saying "checking" after it.

    Anything unexpected is written down as the reason the check failed; the
    page otherwise showed "Checking for an update" until the next restart.
    """
    try:
        return step()
    except Exception as e:  # noqa: BLE001 - the page must hear about anything
        return write_status(checking=False, checked=now_iso(), result="error",
                            error=f"{type(e).__name__}: {e}"[:300])


def cmd_auto(_args) -> int:
    held = lock()
    if not enabled():
        record()
        write_status(result="off")
        print("automatic updates are off")
        return 0
    state = safely(download)
    print(f"check: {state.get('result')} {state.get('error', '')}".rstrip())
    if not state.get("staged"):
        return 0 if state.get("result") != "error" else 1
    while in_window(dt.datetime.now()):
        if not playing():
            print("restarting to finish the update")
            held.close()
            subprocess.run(["systemctl", "reboot"], check=False)
            return 0
        print("something is playing; looking again later")
        time.sleep(RECHECK_SECONDS)
    print("outside the night window; the update finishes on the next restart")
    return 0


def cmd_check(_args) -> int:
    try:
        (config_dir() / REQUEST_NAME).unlink()
    except OSError:
        pass
    write_status(checking=True, phase="checking", detail="")
    with lock():
        state = safely(download)
    print(f"check: {state.get('result')} {state.get('error', '')}".rstrip())
    return 0 if state.get("result") != "error" else 1


def cmd_record(_args) -> int:
    with lock():
        state = record()
    print(json.dumps(state, indent=2))
    return 0


# ---------------------------------------------------------------------------
# For people.
# ---------------------------------------------------------------------------


def when(stamp: str, today: dt.date | None = None) -> str:
    """An ISO time as a person would say it: "today at 3:12", "4 October"."""
    try:
        moment = dt.datetime.fromisoformat(stamp.replace("Z", "+00:00"))
    except (AttributeError, ValueError):
        return ""
    if moment.tzinfo is not None:
        moment = moment.astimezone()
    today = today or dt.date.today()
    clock = f"{moment.hour % 12 or 12}:{moment.minute:02d} {'am' if moment.hour < 12 else 'pm'}"
    if moment.date() == today:
        return f"today at {clock}"
    if moment.date() == today - dt.timedelta(days=1):
        return f"yesterday at {clock}"
    day = f"{moment.day} {moment.strftime('%B')}"
    return day if moment.year == today.year else f"{day} {moment.year}"


def version_line(state: dict) -> str:
    booted = state.get("booted") or {}
    built = when(booted.get("built", ""))
    name = f"Version {booted['version']}" if booted.get("version") else "This version"
    return f"{name}, built {built}" if built else name


def status_line(state: dict) -> str:
    if state.get("checking") and state.get("phase") == "downloading":
        started = when(state.get("started", ""))
        return ("Downloading the new version" + (f", since {started}" if started else "")
                + ". The first one after installing is the whole system, a few GB,"
                " and can take a while. It carries on if you leave this page.")
    if state.get("checking"):
        return "Checking for an update…"
    if state.get("staged"):
        built = when((state["staged"] or {}).get("built", ""))
        return ("An update is ready" + (f", built {built}" if built else "")
                + ". It finishes when the TV restarts.")
    result = state.get("result")
    checked = when(state.get("checked", ""))
    if result == "unmanaged":
        return "This TV is not set up to receive updates yet. See UPDATES in the FreeTVOS docs."
    if result == "error":
        return f"The last check did not work{f' ({checked})' if checked else ''}: {state.get('error', '')}"
    if result == "current":
        return f"Up to date, checked {checked}" if checked else "Up to date"
    if result == "off" or not enabled():
        return "Automatic updates are off"
    return "Not checked yet"


def cmd_status(_args) -> int:
    state = read_status()
    print("automatic updates:", "on" if enabled() else "off")
    print(version_line(state))
    print(status_line(state))
    if state.get("tracking"):
        print("follows:", state["tracking"])
    return 0


def cmd_switch(args) -> int:
    set_enabled(args.cmd == "on")
    print("automatic updates", args.cmd)
    return 0


def cmd_show(_args) -> int:
    sys.path.insert(0, "/usr/share/freetvos")
    import updateui
    return updateui.run(sys.modules[__name__])


def main() -> int:
    parser = argparse.ArgumentParser(
        description=__doc__.split("\n\n")[0],
        formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="cmd")
    sub.add_parser("show").set_defaults(func=cmd_show)
    sub.add_parser("status").set_defaults(func=cmd_status)
    sub.add_parser("on").set_defaults(func=cmd_switch)
    sub.add_parser("off").set_defaults(func=cmd_switch)
    sub.add_parser("auto").set_defaults(func=cmd_auto)
    sub.add_parser("check").set_defaults(func=cmd_check)
    sub.add_parser("record").set_defaults(func=cmd_record)
    args = parser.parse_args()
    if not getattr(args, "func", None):
        parser.print_help()
        return 2
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
