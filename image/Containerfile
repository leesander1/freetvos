# FreeTVOS — a Plasma Bigscreen appliance built as a bootable container.
#
# The whole OS is this file plus the overlay tree. `bootc-image-builder` turns
# the result into a qcow2 for QEMU, a raw image for SD cards, or an installer
# ISO, all from this one definition. Updates are atomic with rollback, which is
# what a set-top box wants and what a package manager cannot give it.
ARG BASE_IMAGE=quay.io/fedora/fedora-bootc:44

# The qml runtime, and only that. The bars at the bottom of the screen are a QML
# overlay, and the one program that runs a QML file ships in Qt's development
# package, which pulls in compilers and cmake. Installing it here and copying
# out the single binary keeps all of that out of the television.
FROM ${BASE_IMAGE} AS qmlruntime
RUN dnf install -y --setopt=install_weak_deps=False qt6-qtdeclarative-devel \
 && dnf clean all

FROM ${BASE_IMAGE}

ARG BRAND_ID=freetvos
ARG BRAND_NAME=FreeTVOS
ARG BRAND_VERSION=0.1.0
ARG BUNDLE_WIDEVINE=no

LABEL org.opencontainers.image.title="${BRAND_NAME}" \
      org.opencontainers.image.version="${BRAND_VERSION}" \
      org.opencontainers.image.description="Plasma Bigscreen TV appliance"

# ---------------------------------------------------------------------------
# Shell and session.
#
# plasma-bigscreen-wayland pulls the Bigscreen session and kwin. plasma-nm and
# bluedevil are not optional on a TV: the first-run experience is joining wifi
# and pairing a remote, and neither is reachable without them.
# ---------------------------------------------------------------------------
# Weak dependencies stay ON for this block, unlike everywhere else in the file.
# Turning them off strips the integration pieces Plasma treats as optional but
# Bigscreen does not: without milou the home screen applet fails to load
# outright, and the TV boots to an empty shell. The extra few hundred megabytes
# buy a working interface. kde-connect is in the same category: the home
# screen's header imports its QML unconditionally, so without it the entire
# HomeScreen type fails to instantiate and the TV shows a QML backtrace. It
# also happens to turn a phone into a remote, which this device wants.
RUN dnf install -y \
      plasma-bigscreen \
      plasma-bigscreen-wayland \
      plasma-workspace \
      plasma-nm \
      plasma-pa \
      bluedevil \
      sddm-breeze \
      sddm \
      sddm-wayland-generic \
      xdg-desktop-portal-kde \
      qqc2-desktop-style \
      kf6-kirigami-addons \
      plasma-milou \
      plasma-settings \
      upower \
      kde-connect \
      kdialog \
      mesa-libEGL \
      mesa-libGL \
      mesa-vulkan-drivers \
 && dnf clean all

# plasma-welcome arrives as a weak dependency and opens a desktop onboarding
# wizard on top of the TV interface at first login. There is no pointer and no
# keyboard on a television, so it is not dismissible in the intended way.
RUN dnf remove -y plasma-welcome || true

# ---------------------------------------------------------------------------
# Media stack.
#
# vaapi and the full gstreamer set matter twice over: once for local playback,
# once because UxPlay decodes the AirPlay H.264 stream through gstreamer.
# ---------------------------------------------------------------------------
# RPM Fusion. Not optional for a media appliance: Fedora cannot ship the
# patent-encumbered ffmpeg that gstreamer1-libav wraps, and without it UxPlay
# refuses to start at all because it has no H.264 decoder for the AirPlay
# stream. The same repo carries the VAAPI drivers real hardware decode needs:
# Fedora's own mesa-va-drivers is built without H.264 and HEVC, so on an AMD
# GPU most streaming video would decode on the processor. The freeworld build
# is the same driver with those codecs left in.
#
# ffmpeg-libs is RPM Fusion's whole ffmpeg, in place of Fedora's cut-down one,
# which the Plasma step above has already pulled in as a weak dependency:
# --allowerasing swaps the six ffmpeg-free libraries out, and nothing else.
# Everything after it (gstreamer, mpv, TVHeadend, Chromium) is then installed
# against the one ffmpeg. Fedora's has no H.264 or HEVC decoder of
# its own, only OpenH264, which plays nothing past the simplest H.264 profile,
# and Chromium decodes through it: YouTube TV's live channels, which are H.264,
# said "This format is not supported". All of ffmpeg's libraries must come from
# the same build. Adding only RPM Fusion's libavcodec-freeworld beside Fedora's
# others paired an 8.0 libavcodec with an 8.1 libavformat, and Chromium would
# not start at all: "undefined symbol: av_exif_parse_buffer".
RUN dnf install -y \
      "https://mirrors.rpmfusion.org/free/fedora/rpmfusion-free-release-$(rpm -E %fedora).noarch.rpm" \
 && dnf clean all

RUN dnf install -y --allowerasing --setopt=install_weak_deps=False \
      ffmpeg-libs \
      gstreamer1-libav \
      pipewire pipewire-pulseaudio pipewire-alsa wireplumber \
      gstreamer1-plugins-base \
      gstreamer1-plugins-good \
      gstreamer1-plugins-bad-free \
      gstreamer1-vaapi \
      mesa-dri-drivers \
      mesa-va-drivers-freeworld \
      libva libva-utils \
      mpv \
      v4l-utils \
      pulseaudio-utils \
      exfatprogs \
      ntfs-3g \
      dosfstools \
 && dnf clean all

# TV tuners. TVHeadend tunes, scans and reads the broadcast guide; the firmware
# package carries what many USB and PCIe tuners load when plugged in. Both are
# installed and neither runs: tuner support is switched on from Live TV, and
# until then TVHeadend is not started at all.
RUN dnf install -y --setopt=install_weak_deps=False \
      tvheadend \
      dvb-firmware \
 && dnf clean all

# ---------------------------------------------------------------------------
# Firmware for real hardware.
#
# The bootc base carries almost none, which a VM never notices. The first
# install on a real box, a mini PC with an Intel 7265 card, came up with no
# wifi and no Bluetooth: "iwlwifi: no suitable firmware found". Joining wifi
# and pairing a remote are the first two things a television does, so this
# ships firmware for the common wireless, Bluetooth and GPU chips rather than
# only for the box it was tested on.
# ---------------------------------------------------------------------------
RUN dnf install -y --setopt=install_weak_deps=False \
      linux-firmware \
      amd-gpu-firmware amd-ucode-firmware intel-gpu-firmware \
      iwlwifi-mvm-firmware iwlwifi-dvm-firmware iwlbluetooth-firmware \
      mt7xxx-firmware realtek-firmware atheros-firmware brcmfmac-firmware \
      intel-audio-firmware \
 && dnf clean all

# ---------------------------------------------------------------------------
# Casting receivers.
#
# UxPlay gives real AirPlay mirroring and audio. There is no legitimate open
# Chromecast receiver, so phone-to-TV for YouTube arrives over DIAL instead;
# see cast/dial. avahi carries the mDNS advertisement both depend on.
# ---------------------------------------------------------------------------
RUN dnf install -y --setopt=install_weak_deps=False \
      uxplay \
      avahi \
      nss-mdns \
 && dnf clean all

# ---------------------------------------------------------------------------
# Web app runtime and system plumbing.
#
# Chromium decodes video with the system ffmpeg, which is RPM Fusion's full one,
# installed with the media stack above.
# ---------------------------------------------------------------------------
RUN dnf install -y --setopt=install_weak_deps=False \
      chromium \
      NetworkManager-wifi \
      plymouth plymouth-system-theme \
      plymouth-plugin-script \
      libcec \
      python3 \
      google-noto-sans-fonts \
      google-noto-sans-mono-fonts \
      openssh-server \
      glibc-langpack-en \
      squashfs-tools \
      flatpak \
 && dnf clean all

# Fail the build rather than ship a Chromium that cannot start, or cannot play
# live TV. Every page and every app on this television is a Chromium window.
#   - Every symbol it needs must resolve: ldd -r lists any that do not, which
#     is how a mismatched ffmpeg shows up, and running it proves it starts.
#   - Fedora's ffmpeg-free must be absent, not mixed in.
#   - The libavcodec it links against, found the way it finds it, must decode
#     H.264 and HEVC.
RUN set -e; \
    BIN=/usr/lib64/chromium-browser/chromium-browser; \
    if ldd -r "$BIN" 2>&1 | grep -E 'undefined symbol|not found'; then \
      echo "Chromium has unresolved libraries or symbols" >&2; exit 1; fi; \
    chromium-browser --version; \
    if rpm -q libavcodec-free; then \
      echo "Fedora's ffmpeg-free is installed beside RPM Fusion's" >&2; exit 1; fi; \
    AVCODEC="$(ldd "$BIN" | awk '/libavcodec/ {print $1}')"; \
    test -n "$AVCODEC"; \
    python3 -c 'import ctypes, sys; lib = ctypes.CDLL(sys.argv[1]); \
lib.avcodec_find_decoder_by_name.restype = ctypes.c_void_p; \
missing = [n for n in ("h264", "hevc") if not lib.avcodec_find_decoder_by_name(n.encode())]; \
assert not missing, "Chromium would have no decoder for %s" % missing' "$AVCODEC"

# ---------------------------------------------------------------------------
# Overlay: units, launchers, branding, app definitions.
# ---------------------------------------------------------------------------
COPY image/overlay/ /

# Web app definitions land in /usr/share/<brand>/webapps and are read at launch
# by the shared wrapper, so adding a service is one file and no new code.
COPY webapps/apps.d/ /usr/share/freetvos/webapps/
COPY webapps/freetvos-webapp /usr/bin/freetvos-webapp
COPY cast/dial/ /usr/share/freetvos/dial/

# The ARM Widevine path needs an ELF patcher and squashfs tooling. Vendored
# rather than fetched at install time, so the device is not downloading and
# running a script from the internet as root. MIT licensed; see the LICENSE
# file alongside it.
# Icon theme. Scalable SVG rather than rasters: the theme handles it natively,
# it stays sharp on a 4K panel, and it needs no rasteriser in the build.
COPY brand/icons/ /usr/share/icons/hicolor/scalable/apps/

# Every raster the image uses, drawn from the SVG masters in brand/ by
# tools/gen-assets.sh, so the build copies pictures rather than drawing them.
# The sized icons are what an icon looked up by name gets, which is how
# os-release's LOGO= finds the mark; until now only the scalable SVG was
# installed. The same splash logo goes to Plymouth and the Plasma session
# splash, so boot and login show one picture.
COPY brand/png/hicolor/ /usr/share/icons/hicolor/
COPY brand/png/splash/logo.png /usr/share/plymouth/themes/freetvos/logo.png
COPY brand/png/splash/logo.png \
     /usr/share/plasma/look-and-feel/org.freetvos.bigscreen/contents/splash/images/logo.png
# Splash.qml draws images/background.png under its ground colour, and the image
# never shipped one, so every login asked for a file that was not there.
COPY brand/png/splash/background.png \
     /usr/share/plasma/look-and-feel/org.freetvos.bigscreen/contents/splash/images/background.png
COPY brand/png/wallpaper/ /usr/share/wallpapers/FreeTVOS/contents/images/
# The wordmark heads the setup wizard's first page. The SVG, not a PNG: its text
# is already outlined, so it stays sharp on a 4K panel and needs no fonts.
COPY brand/logo/freetvos-wordmark.svg /usr/share/freetvos/brand/freetvos-wordmark.svg

COPY --from=qmlruntime /usr/lib64/qt6/bin/qml /usr/lib64/qt6/bin/qml

COPY tools/vendor/widevine_patch.py /usr/share/freetvos/widevine/widevine_patch.py
COPY tools/vendor/LICENSE.pivine /usr/share/freetvos/widevine/LICENSE.pivine

RUN chmod 0755 /usr/bin/freetvos-webapp /usr/bin/freetvos-firstboot \
              /usr/bin/freetvos-widevine-install /usr/bin/freetvos-ensure-groups \
              /usr/bin/freetvos-widevine-check \
              /usr/bin/freetvos-apps /usr/bin/freetvos-pin \
              /usr/bin/freetvos-settings /usr/bin/freetvos-split \
              /usr/bin/freetvos-combo /usr/bin/freetvos-pick \
              /usr/bin/freetvos-cec \
              /usr/bin/freetvos-hdmi /usr/bin/freetvos-hdmi-view \
              /usr/bin/freetvos-service \
              /usr/bin/freetvos-media /usr/bin/freetvos-play \
              /usr/bin/freetvos-usb-mount /usr/bin/freetvos-tune \
              /usr/bin/freetvos-moonlight /usr/bin/freetvos-sports \
              /usr/bin/freetvos-setup /usr/bin/freetvos-jellyfin \
              /usr/bin/freetvos-bars \
              /usr/bin/freetvos-livetv /usr/bin/freetvos-livetv-player \
              /usr/bin/freetvos-meet /usr/bin/freetvos-tuner \
              /usr/bin/freetvos-pin-host /usr/bin/freetvos-update \
 && python3 /usr/share/freetvos/generate-desktop-entries.py \
 && python3 /usr/share/freetvos/curate-apps.py \
 && python3 /usr/share/freetvos/brand-os-release.py \
 && ln -sfn FreeTVOS /usr/share/wallpapers/Default \
 && python3 /usr/share/freetvos/tune-shell-defaults.py \
 && python3 /usr/share/freetvos/tune-homescreen.py \
 && gtk-update-icon-cache -f -t /usr/share/icons/hicolor 2>/dev/null || true

# The splash between logging in and the home screen. The Bigscreen session pins
# its own look-and-feel, org.kde.plasma.bigscreen, and Plasma copies that
# package's splash choice into the viewer's kdedefaults, which outranks any
# ksplashrc in /etc/xdg; so the KDE and Plasma logos showed whatever FreeTVOS
# asked for. Swapping the whole look-and-feel would also swap the home screen's
# layout, which FreeTVOS's package does not carry. Replacing only the splash
# inside Bigscreen's package draws the FreeTVOS one whichever package is chosen.
# A step of its own, not part of the one above, whose "|| true" would hide it.
RUN B=/usr/share/plasma/look-and-feel/org.kde.plasma.bigscreen/contents/splash \
 && F=/usr/share/plasma/look-and-feel/org.freetvos.bigscreen/contents/splash \
 && test -f "$F/Splash.qml" && test -f "$F/images/logo.png" \
 && rm -rf "$B" && cp -a "$F" "$B"

# ---------------------------------------------------------------------------
# Services. sddm auto-logs into the Bigscreen session; a TV has no login screen.
# ---------------------------------------------------------------------------
# sshd is how you inspect a running TV. It has no keyboard and no terminal,
# so without it a failed service is invisible.
# Widevine, baked in or not.
#
# Bundling is only appropriate for an image that stays on your own machines:
# the licence does not permit redistributing the module. When bundled it lives
# in /usr, so it is part of the image and survives the /var wipe that a disk
# rebuild performs. When not, /opt points at /var and the module is fetched on
# the device by the timer instead.
#
# The same script does the work either way, pointed at a different root, so the
# bundled path is not a second, less-tested copy of the extraction and patching.
RUN if [ "$BUNDLE_WIDEVINE" = "yes" ]; then \
      FREETVOS_CDM_ROOT=/usr/lib/freetvos/widevine \
        /usr/bin/freetvos-widevine-install \
      && rm -f /opt/google/chrome/WidevineCdm \
      && ln -sfn /usr/lib/freetvos/widevine/WidevineCdm \
                 /opt/google/chrome/WidevineCdm \
      && echo "Widevine bundled into the image"; \
    else \
      echo "Widevine will be fetched on the device"; \
    fi

RUN systemctl enable sddm avahi-daemon bluetooth NetworkManager sshd \
 && systemctl enable freetvos-user-groups.service \

 && systemctl --global enable freetvos-cec-claim.service \
 && systemctl --global enable freetvos-hdmi-monitor.service \
 && systemctl --global enable freetvos-setup.service \
 && systemctl --global enable freetvos-bars.service \
 && systemctl enable freetvos-tuner-boot.service \
 && systemctl enable freetvos-airplay.service freetvos-firstboot.service freetvos-dial.service \
 && systemctl set-default graphical.target \
 && if [ "$BUNDLE_WIDEVINE" != "yes" ]; then \
      systemctl enable freetvos-widevine-install.timer; \
    fi

# Updates. bootc's own timer downloads an update and restarts the machine the
# moment it has one, whatever is on screen; FreeTVOS's waits for the night and
# for nothing to be playing, and has a switch on the Updates page. So bootc's
# is masked and FreeTVOS's enabled. See docs/UPDATES.md.
RUN systemctl mask bootc-fetch-apply-updates.timer \
 && systemctl enable freetvos-update.timer freetvos-update-check.path \
      freetvos-update-status.service

# bootc requires /var to stay empty at build time; anything written here would
# become a one-time factory default rather than real state.
# /run/secrets and the resolver stub are podman's own bind mounts and cannot
# be removed here, so clear only what the package installs actually left behind.
# The boot splash from the very first frame. Plymouth starts inside the
# initramfs, and the base image's initramfs was built before the FreeTVOS theme
# existed, so boots showed Fedora's theme (the firmware logo and a Fedora mark)
# until the root filesystem took over. Rebuilding it here picks up the theme
# plymouthd.conf selects. The theme is a script theme, and Plymouth only
# copies a theme whose plugin is installed: without plymouth-plugin-script the
# theme's folder arrived empty and the boot logo had never once been drawn.
# DRACUT_NO_XATTR because a container build cannot set
# the extended attributes dracut otherwise tries to copy. /root is a link to
# /var/roothome on this image and /var is empty while building, so dracut's
# attempt to copy /root fails until the folder exists; it is made for the
# rebuild and removed again, since /var must be empty in the finished image.
RUN set -e; KVER="$(ls /usr/lib/modules)"; \
    test "$(printf '%s\n' "$KVER" | wc -l)" -eq 1; \
    grep -q '^Theme=freetvos' /etc/plymouth/plymouthd.conf; \
    mkdir -p /var/roothome; \
    env DRACUT_NO_XATTR=1 dracut --force --no-hostonly --add plymouth \
      "/usr/lib/modules/$KVER/initramfs.img" "$KVER"; \
    rm -rf /var/roothome /var/tmp/dracut.*; \
    lsinitrd "/usr/lib/modules/$KVER/initramfs.img" | grep -q 'plymouth/themes/freetvos/logo.png'

RUN rm -rf /var/cache/* /var/log/* /var/tmp/* /tmp/* \
      /run/dnf /run/sddm /run/tuned \
      /var/lib/dnf /var/lib/authselect/checksum \
      /var/lib/AccountsService /var/lib/geoclue \
      /var/lib/plymouth /var/spool/plymouth \
      /var/lib/PackageKit /var/lib/tuned \
 && bootc container lint
