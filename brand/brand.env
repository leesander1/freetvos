# Single source of truth for product identity.
# Every script, unit, and asset name derives from these. Change here, rebuild.

BRAND_ID="freetvos"
BRAND_NAME="FreeTVOS"
BRAND_TAGLINE="An open TV for open media"
BRAND_VERSION="0.1.0"

# Upstream base
FEDORA_RELEASE="44"
BASE_IMAGE="quay.io/fedora/fedora-bootc:${FEDORA_RELEASE}"

# Local build targets
IMAGE_REF="localhost/${BRAND_ID}"
ARCH_DEFAULT="arm64"

# Appliance user (auto-login, no password, owns app profiles)
TV_USER="tv"
TV_UID="1000"

# Palette. Dark-first, tuned for 10-foot viewing on an emissive panel.
# Deliberately low peak luminance: pure white on OLED is fatiguing at 3m.
BRAND_BG="#0B0E14"
BRAND_SURFACE="#151A23"
BRAND_ACCENT="#3DDC97"
BRAND_ACCENT_ALT="#4EA8FF"
BRAND_TEXT="#E6EAF2"
BRAND_TEXT_DIM="#8C97AB"
