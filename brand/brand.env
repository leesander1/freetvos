# Single source of truth for product identity.
# Every script, unit, and asset name derives from these. Change here, rebuild.

BRAND_ID="freetvos"
BRAND_NAME="FreeTVOS"
BRAND_TAGLINE="An open TV for open media"
BRAND_VERSION="0.1.0"

# Upstream base
FEDORA_RELEASE="44"
BASE_IMAGE="quay.io/fedora/fedora-bootc:${FEDORA_RELEASE}"

# Local build targets
IMAGE_REF="localhost/${BRAND_ID}"
ARCH_DEFAULT="arm64"

# Appliance user (auto-login, no password, owns app profiles)
TV_USER="tv"
TV_UID="1000"

# Palette. Dark-first, tuned for 10-foot viewing on an emissive panel.
# Deliberately low peak luminance: pure white on OLED is fatiguing at 3m.
BRAND_BG="#0B0E14"
BRAND_SURFACE="#151A23"
BRAND_ACCENT="#3DDC97"
BRAND_ACCENT_ALT="#4EA8FF"
BRAND_TEXT="#E6EAF2"
BRAND_TEXT_DIM="#8C97AB"

# Bake the Widevine module into the image rather than fetching it on the device.
#
# Yes for a local build: the module is then present from first boot, needs no
# network, and survives the disk rebuilds that otherwise wipe /var and take it
# with them.
#
# Set to "no" before building an image that leaves this machine. The licence
# does not permit redistributing the module, so a bundled image cannot be
# handed to anyone else; an unbundled one fetches it on the device instead,
# which is what Raspberry Pi OS and LibreELEC do.
BUNDLE_WIDEVINE="yes"
